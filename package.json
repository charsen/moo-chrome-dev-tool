{
  "name": "moo-chrome-dev-tool",
  "version": "0.8.17",
  "private": true,
  "type": "module",
  "description": "前后端业务调试 Chrome 扩展",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "type-check:tests": "vue-tsc --noEmit -p tsconfig.tests.json",
    "lint": "eslint .",
    "check:versions": "node scripts/check-version-consistency.mjs",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "mock": "node scripts/mock-server.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "release": "node scripts/release.mjs",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check:versions && pnpm type-check && pnpm type-check:tests && pnpm test"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.0.263",
    "@types/node": "^25.9.6",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "sharp": "^0.35.4",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.12"
  }
}
