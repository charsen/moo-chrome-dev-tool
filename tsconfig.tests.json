{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false,
    "types": ["chrome", "vite/client", "node", "vitest/globals"]
  },
  "include": [
    "src/**/*.ts", "src/**/*.tsx", "src/**/*.vue",
    "tests/**/*.ts", "tests-e2e/**/*.ts", "tests-real/**/*.ts",
    "vite.config.ts", "playwright.config.ts", "playwright.real.config.ts"
  ]
}
